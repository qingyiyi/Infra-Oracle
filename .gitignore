# Default-deny public repo policy: ignore everything first.
*

# Keep this file tracked.
!.gitignore

# Public repo root files.
!README.md
!astro.config.mjs
!package.json
!package-lock.json
!tsconfig.json

# Frontend source.
!src/
!src/**
!public/
!public/**

# Public editorial helper scripts.
!scripts/
!scripts/radar-weekly.sh
!scripts/radar-weekly-auto-publish.mjs
!scripts/radar-weekly-generate.mjs
!scripts/radar-weekly-preview.mjs
!scripts/radar-weekly-publish.mjs
!scripts/radar-weekly-utils.mjs

# GitHub Pages workflow only.
!.github/
!.github/workflows/
!.github/workflows/deploy.yml

# Derived Hypo-Workflow compact context views.
*.compact.*
