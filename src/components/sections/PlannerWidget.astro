---
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import Panel from "../ui/Panel.astro";
import {
  defaultPlannerTasks,
  getPlannerDayTaskLayout,
  getPlannerPayload,
  getPlannerTaskType,
  getTaskStartMinutes,
  getTaskEndMinutes,
  plannerDays,
  plannerEndMinute,
  plannerStartMinute,
  plannerTotalMinutes,
} from "../../lib/planner";
import { siteRoutes, withBase } from "../../lib/routes";

const plannerPayload = JSON.stringify(getPlannerPayload()).replace(/</g, "\\u003c");
const plannerHref = withBase(siteRoutes.planner);
const plannerTwoHourTicks = Array.from({ length: 10 }, (_, index) => {
  const minutes = plannerStartMinute + index * 120;
  const hours = Math.trunc(minutes / 60);
  return `${String(hours).padStart(2, "0")}:00`;
});
---

<Panel as="aside" tone="subtle" padding="lg" class="planner-widget" data-planner-widget>
  <div class="planner-widget__header">
    <div>
      <p class="mono-label">Weekly Plan</p>
      <h2 class="title-3">本周时间轴</h2>
    </div>
    <Badge tone="accent" data-planner-widget-count>{defaultPlannerTasks.length} items</Badge>
  </div>

  <a class="planner-widget__gantt-link" href={plannerHref} aria-label="打开 Planner 编辑本周时间表">
    <div class="planner-widget__gantt" data-planner-widget-gantt>
      <div class="planner-widget__days" aria-hidden="true">
        <span></span>
        {plannerDays.map((day) => (
          <strong>{day.label}</strong>
        ))}
      </div>

      <div class="planner-widget__scroll">
        <div class="planner-widget__timeline" data-planner-widget-timeline>
          <div class="planner-widget__time-axis" aria-hidden="true">
            {plannerTwoHourTicks.map((tick, index) => (
              <span style={`--tick-top: ${(index * 120 / plannerTotalMinutes) * 100}%;`}>{tick}</span>
            ))}
          </div>
          <div class="planner-widget__grid" data-planner-widget-grid>
            {plannerDays.map((day) => {
              const layout = getPlannerDayTaskLayout(defaultPlannerTasks.filter((task) => task.day === day.index));
              return (
                <section class="planner-widget__day-column" data-planner-day={day.index}>
                  {layout.items.map(({ task, laneIndex }) => {
                    const type = getPlannerTaskType(task.type);
                    const start = Math.max(plannerStartMinute, Math.min(plannerEndMinute, getTaskStartMinutes(task)));
                    const end = Math.max(start + 1, Math.min(plannerEndMinute, getTaskEndMinutes(task)));
                    const top = ((start - plannerStartMinute) / plannerTotalMinutes) * 100;
                    const height = ((end - start) / plannerTotalMinutes) * 100;
                    const laneWidth = 100 / layout.laneCount;
                    return (
                      <span
                        class="planner-widget__task"
                        style={`--task-top: ${top}%; --task-height: ${height}%; --task-lane-left: ${laneIndex * laneWidth}%; --task-lane-width: ${laneWidth}%; --task-color: ${type.color};`}
                        title={`${day.label} ${task.startTime}-${task.endTime} · ${type.label}`}
                      >
                        {task.title}
                      </span>
                    );
                  })}
                </section>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </a>

  <div class="planner-widget__footer">
    <p class="caption">横着看一周，竖着看时间；点开就能细改。</p>
    <Button href={plannerHref} variant="secondary" size="sm">打开 Planner</Button>
  </div>

  <script is:inline type="application/json" data-planner-widget-data set:html={plannerPayload}></script>
  <script is:inline>
    (() => {
      const widget = document.querySelector("[data-planner-widget]");
      const dataNode = widget?.querySelector("[data-planner-widget-data]");
      const grid = widget?.querySelector("[data-planner-widget-grid]");
      const count = widget?.querySelector("[data-planner-widget-count]");

      if (!widget || !dataNode || !grid) return;

      let payload;

      try {
        payload = JSON.parse(dataNode.textContent || "{}");
      } catch {
        return;
      }

      const storageKey = payload.storageKey || "infra-oracle.weekly-planner.v2";
      const taskTypes = Array.isArray(payload.taskTypes) ? payload.taskTypes : [];
      const defaultTasks = Array.isArray(payload.defaultTasks) ? payload.defaultTasks : [];
      const days = Array.isArray(payload.days) ? payload.days : [];
      const startMinute = Number(payload.startMinute || 360);
      const endMinute = Number(payload.endMinute || 1440);
      const totalMinutes = endMinute - startMinute;
      const typeMap = new Map(taskTypes.map((type) => [type.id, type]));

      function clampDay(value) {
        const number = Number(value);
        if (!Number.isFinite(number)) return 0;
        return Math.max(0, Math.min(6, Math.trunc(number)));
      }

      function timeToMinutes(value) {
        const match = String(value || "").trim().match(/^(\d{1,2}):(\d{2})$/);
        if (!match) return null;
        const hours = Number(match[1]);
        const minutes = Number(match[2]);
        if (!Number.isInteger(hours) || !Number.isInteger(minutes)) return null;
        if (hours < 0 || hours > 24 || minutes < 0 || minutes > 59) return null;
        if (hours === 24 && minutes !== 0) return null;
        return hours * 60 + minutes;
      }

      function minutesToTime(value) {
        const minutes = Math.max(0, Math.min(24 * 60, Math.trunc(value)));
        const hoursPart = Math.trunc(minutes / 60);
        const minutesPart = minutes % 60;
        return `${String(hoursPart).padStart(2, "0")}:${String(minutesPart).padStart(2, "0")}`;
      }

      function normalizeTask(task, index = 0) {
        if (!task || typeof task !== "object") return null;
        const title = String(task.title || "").trim().slice(0, 60);
        if (!title) return null;

        const start = Math.max(startMinute, Math.min(endMinute - 1, timeToMinutes(task.startTime) ?? startMinute));
        const end = Math.max(start + 1, Math.min(endMinute, timeToMinutes(task.endTime) ?? start + 60));

        return {
          id: String(task.id || `task-${index + 1}`),
          title,
          type: typeMap.has(task.type) ? task.type : "custom",
          day: clampDay(task.day),
          startTime: minutesToTime(start),
          endTime: minutesToTime(end),
          note: String(task.note || "").trim().slice(0, 120),
        };
      }

      function normalizeTasks(rawTasks) {
        const next = Array.isArray(rawTasks)
          ? rawTasks.map(normalizeTask).filter(Boolean)
          : defaultTasks.map(normalizeTask).filter(Boolean);
        return next.slice().sort((a, b) =>
          a.day - b.day ||
          (timeToMinutes(a.startTime) || startMinute) - (timeToMinutes(b.startTime) || startMinute) ||
          (timeToMinutes(a.endTime) || endMinute) - (timeToMinutes(b.endTime) || endMinute) ||
          a.title.localeCompare(b.title)
        );
      }

      function loadTasks() {
        try {
          return normalizeTasks(JSON.parse(window.localStorage.getItem(storageKey) || "null"));
        } catch {
          return normalizeTasks(defaultTasks);
        }
      }

      function taskType(task) {
        return typeMap.get(task.type) || typeMap.get("custom") || { label: "自定义", color: "#c7cad2" };
      }

      function taskStyle(task, type) {
        const start = Math.max(startMinute, Math.min(endMinute, timeToMinutes(task.startTime) ?? startMinute));
        const end = Math.max(start + 1, Math.min(endMinute, timeToMinutes(task.endTime) ?? endMinute));
        return {
          top: ((start - startMinute) / totalMinutes) * 100,
          height: ((end - start) / totalMinutes) * 100,
          color: type.color,
        };
      }

      function getDayTaskLayout(dayTasks) {
        const sorted = dayTasks.slice().sort((a, b) =>
          (timeToMinutes(a.startTime) || startMinute) - (timeToMinutes(b.startTime) || startMinute) ||
          (timeToMinutes(a.endTime) || endMinute) - (timeToMinutes(b.endTime) || endMinute) ||
          a.title.localeCompare(b.title)
        );
        const laneEnds = [];
        const items = sorted.map((task) => {
          const start = timeToMinutes(task.startTime) || startMinute;
          const end = timeToMinutes(task.endTime) || endMinute;
          let laneIndex = laneEnds.findIndex((laneEnd) => laneEnd <= start);

          if (laneIndex === -1) {
            laneIndex = laneEnds.length;
            laneEnds.push(end);
          } else {
            laneEnds[laneIndex] = end;
          }

          return { task, laneIndex };
        });
        return { items, laneCount: Math.max(laneEnds.length, 1) };
      }

      function render() {
        const tasks = loadTasks();
        grid.replaceChildren();
        if (count) count.textContent = `${tasks.length} items`;

        for (const day of days) {
          const column = document.createElement("section");
          column.className = "planner-widget__day-column";
          column.dataset.plannerDay = String(day.index);
          const layout = getDayTaskLayout(tasks.filter((item) => item.day === day.index));

          for (const { task, laneIndex } of layout.items) {
            const type = taskType(task);
            const position = taskStyle(task, type);
            const laneWidth = 100 / layout.laneCount;
            const block = document.createElement("span");
            block.className = "planner-widget__task";
            block.style.setProperty("--task-top", `${position.top}%`);
            block.style.setProperty("--task-height", `${position.height}%`);
            block.style.setProperty("--task-lane-left", `${laneIndex * laneWidth}%`);
            block.style.setProperty("--task-lane-width", `${laneWidth}%`);
            block.style.setProperty("--task-color", position.color);
            block.title = `${day.label} ${task.startTime}-${task.endTime} · ${type.label}`;
            block.textContent = task.title;
            column.append(block);
          }

          grid.append(column);
        }
      }

      render();
      window.addEventListener("storage", (event) => {
        if (event.key === storageKey) render();
      });
    })();
  </script>
</Panel>
