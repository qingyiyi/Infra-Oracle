---
interface Props {
  id: string;
  label: string;
  name?: string;
  placeholder?: string;
  hint?: string;
  value?: string;
  type?: "text" | "email" | "password" | "search" | "url";
}

const {
  id,
  label,
  name = id,
  placeholder,
  hint,
  value,
  type = "text",
} = Astro.props as Props;
---

<div class="field">
  <label class="field__label" for={id}>{label}</label>
  <input
    class="field__control"
    id={id}
    name={name}
    type={type}
    placeholder={placeholder}
    value={value}
  />
  {hint && <p class="field__hint">{hint}</p>}
</div>
