---
interface Props {
  as?: "div" | "section" | "article" | "aside";
  tone?: "default" | "accent" | "subtle";
  padding?: "md" | "lg";
  class?: string;
}

const {
  as = "div",
  tone = "default",
  padding = "md",
  class: className = "",
} = Astro.props as Props;

const Tag = as;
---

<Tag class:list={["panel", `panel--${tone}`, `panel--${padding}`, className]}>
  <slot />
</Tag>
