---
import BaseLayout from "../layouts/BaseLayout.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import FortuneWidget from "../components/sections/FortuneWidget.astro";
import Panel from "../components/ui/Panel.astro";
import {
  formatRadarDate,
  getPublishedRadarEntries,
  getRadarHighlights,
  getRadarIssuePath,
  getRadarWeekRange,
  radarCategoryLabels,
} from "../lib/radar";
import { siteRoutes, withBase } from "../lib/routes";

const radarEntries = await getPublishedRadarEntries();
const latestRadar = radarEntries[0];
const latestRadarDate = latestRadar ? formatRadarDate(latestRadar.data.published_at) : null;
const latestRadarRoute = latestRadar ? getRadarIssuePath(latestRadar.slug) : withBase(siteRoutes.radar);
const latestRadarHighlights = latestRadar ? getRadarHighlights(latestRadar, 3) : [];
const latestRadarRange = latestRadar ? getRadarWeekRange(latestRadar) : null;

const statusItems = [
  {
    label: "Radar",
    value: latestRadar ? `${latestRadar.data.week_label} live` : "drafting",
    note: latestRadar ? latestRadar.data.hero_note : "等待第一期人工发布。",
  },
  {
    label: "Runner",
    value: "prototype",
    note: "公开页只展示入口和边界，真实执行依赖受控后端。",
  },
  {
    label: "Fortune",
    value: "daily fixed",
    note: "首页右侧轻量签面，不进入独立导航。",
  },
];

const futureExperiments = [
  {
    title: "Heartbeat",
    summary: "提醒、review 入口和轻量自动化的候选位置。",
  },
  {
    title: "Tooling Radar",
    summary: "更细分地跟踪推理框架、agent 工具和工程实践。",
  },
  {
    title: "Reproduction Board",
    summary: "承载论文复现、系统实验和方法追踪记录。",
  },
];
---

<BaseLayout
  active="home"
  title="GitHub Page / AI Infra & Codex Lab"
  description="一个围绕 AI Infra、LLM、HPC、Codex 与 agent workflow 的 static-first 技术实验站。"
>
  <section class="section page-intro">
    <div class="hero-copy hero-copy--compact">
      <div class="cluster">
        <Badge tone="accent">Weekly Radar</Badge>
        <Badge tone="success">Runner Prototype</Badge>
        <Badge>Cyber Fortune</Badge>
      </div>

      <div class="stack">
        <p class="eyebrow">AI Infra / LLM / HPC / Codex / Agent Workflow</p>
        <h1 class="title-display">
          Infra-Oracle keeps the signal sharp and the tools close.
        </h1>
        <p class="body-lg">
          一个 static-first 技术实验站：用人工审查的 Radar 看 AI Infra 动态，用 Runner 原型整理任务边界，再留一点每日签面的轻松感。
        </p>
      </div>

      <div class="action-row">
        <Button href={latestRadarRoute} variant="primary">查看本期 Radar</Button>
        <Button href={withBase(siteRoutes.runner)} variant="secondary">进入 Runner</Button>
        <Button href="#future-experiments" variant="ghost">Future Lab</Button>
      </div>
    </div>

    <div class="page-intro__rail">
      <FortuneWidget />

      <Panel as="aside" tone="subtle" padding="lg" class="status-card">
        <div class="callout-row">
          <Badge tone="accent">Now</Badge>
          <Badge>{latestRadarDate ?? "static"}</Badge>
        </div>
        <h2 class="title-3">Today&apos;s surface</h2>
        <ul class="status-list">
          {statusItems.map((item) => (
            <li>
              <div>
                <span>{item.label}</span>
                <strong>{item.value}</strong>
              </div>
              <p>{item.note}</p>
            </li>
          ))}
        </ul>
      </Panel>
    </div>
  </section>

  <section class="section home-surface">
    <div class="home-surface__header">
      <div class="section-header__copy">
        <p class="eyebrow">Latest Radar / 本周重点</p>
        <h2 class="title-1">{latestRadar ? latestRadar.data.title : "Weekly AI Infra Radar"}</h2>
        <p class="body-md">
          {latestRadar
            ? latestRadar.data.summary
            : "每周一整理上一完整周的 AI Infra / LLM / HPC 信号，先人工确认，再发布到静态站点。"}
        </p>
      </div>
      <div class="action-row">
        {latestRadarRange && <Badge>{latestRadarRange}</Badge>}
        <Button href={withBase(siteRoutes.radar)} variant="secondary" size="sm">全部期数</Button>
      </div>
    </div>

    {latestRadarHighlights.length > 0 && (
      <div class="radar-feature-grid">
        {latestRadarHighlights.map((item) => (
          <article class="radar-feature-card">
            <a
              class="radar-feature-card__media"
              href={item.image_source_url ?? item.source_url}
              target="_blank"
              rel="noreferrer"
              aria-label={`查看图片或来源：${item.title}`}
            >
              {item.image_url ? (
                <img src={item.image_url} alt={item.image_alt ?? item.title} loading="lazy" />
              ) : (
                <span>{radarCategoryLabels[item.category]}</span>
              )}
            </a>
            <div class="radar-feature-card__body">
              <div class="callout-row">
                <Badge tone="accent">{radarCategoryLabels[item.category]}</Badge>
                <Badge>{item.importance}</Badge>
              </div>
              <h3 class="title-3">{item.title}</h3>
              <p class="body-sm">{item.impact ?? item.why_it_matters}</p>
            </div>
          </article>
        ))}
      </div>
    )}

    <div class="surface-row">
      <Panel as="article" padding="lg" class="runner-home-card">
        <div class="callout-row">
          <Badge tone="warning">Web Codex Runner</Badge>
          <Badge>guarded prototype</Badge>
        </div>
        <div class="runner-home-card__copy">
          <h2 class="title-2">A conversation workbench for documents and research tasks.</h2>
          <p class="body-md">
            面向少量协作者的对话式工作台：上传资料、联网检索、生成 Markdown / Word。公开页面只承载入口和边界，模型密钥、文件和执行日志都不进入前端仓库。
          </p>
        </div>
        <div class="runner-home-card__footer">
          <div class="cluster">
            <Badge>files</Badge>
            <Badge>web search</Badge>
            <Badge>docx export</Badge>
          </div>
          <Button href={withBase(siteRoutes.runner)} variant="secondary">打开 Runner</Button>
        </div>
      </Panel>

      <Panel as="article" tone="accent" padding="lg" class="editor-note-card">
        <p class="mono-label">Editorial lens</p>
        <h3 class="title-3">{latestRadar ? latestRadar.data.hero_note : "Human review before publish."}</h3>
        <p class="body-sm">
          Radar 优先看模型分发、算力栈、agent 控制面和供应链变化；国际局势只在直接影响 AI Infra 时进入周报。
        </p>
      </Panel>
    </div>
  </section>

  <section class="section future-section" id="future-experiments">
    <div class="home-surface__header">
      <div class="section-header__copy">
        <p class="eyebrow">Future Experiments</p>
        <h2 class="title-2">Small slots for the next useful surfaces.</h2>
      </div>
    </div>

    <div class="future-grid">
      {futureExperiments.map((item) => (
        <article class="future-card">
          <span>Lab</span>
          <h3>{item.title}</h3>
          <p>{item.summary}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
