---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import Panel from "../../components/ui/Panel.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import { siteRoutes, withBase } from "../../lib/routes";

const sampleFortune = {
  tier: "吉",
  headline: "今天适合稳定推进",
  summary: "适合做确定性高、回报清晰的工作。",
  doList: ["整理 README", "跑 benchmark"],
  dontList: ["周五深夜重构核心接口", "把 API Key 放前端"],
  disclaimer: "仅供娱乐，不作为真实决策依据。",
};
---

<BaseLayout
  active="fortune"
  title="Fortune | GitHub Page / AI Infra & Codex Lab"
  description="Cyber Fortune 的当前示例签面、边界说明和后续玩法方向。"
>
  <section class="section page-intro">
    <div class="hero-copy">
      <div class="cluster">
        <Badge tone="accent">Cyber Fortune</Badge>
        <Badge tone="warning">{sampleFortune.tier}</Badge>
        <Badge>entertainment-only</Badge>
      </div>
      <div class="stack">
        <p class="eyebrow">Developer Fortune Surface</p>
        <h1 class="title-display">轻量、有记忆点，但不假装自己是决策系统。</h1>
        <p class="body-lg">
          Fortune 模块负责增加趣味性和识别度，用程序员语境改写签文和宜忌。它始终是娱乐化模块，不会被包装成严肃建议系统。
        </p>
      </div>
      <div class="action-row">
        <Button href={withBase(siteRoutes.home)} variant="secondary">返回首页</Button>
        <Button href="#sample-draw" variant="ghost">查看示例签面</Button>
      </div>
    </div>

    <div class="page-intro__rail">
      <Panel tone="accent" padding="lg">
        <p class="mono-label">Current scope</p>
        <h2 class="title-2">A playful module with explicit guardrails.</h2>
        <p class="body-sm">
          当前重点是签面结构、语气和免责声明，不会在这一轮加入历史记录、个性化推荐或任何看起来像真实判断的能力。
        </p>
      </Panel>
    </div>
  </section>

  <section class="section" id="sample-draw">
    <SectionHeader
      eyebrow="Sample Draw"
      title={`${sampleFortune.tier} · ${sampleFortune.headline}`}
      description="首版先展示静态样例和规则边界，后续再决定是否做每日固定结果或手动重新抽签。"
    />

    <div class="split-grid">
      <Panel as="article" tone="accent" padding="lg">
        <p class="body-md">{sampleFortune.summary}</p>
        <div class="two-column-list">
          <Panel tone="subtle">
            <p class="mono-label">宜做</p>
            <ul class="surface-list">
              {sampleFortune.doList.map((item) => (
                <li><p class="body-sm">{item}</p></li>
              ))}
            </ul>
          </Panel>
          <Panel tone="subtle">
            <p class="mono-label">忌做</p>
            <ul class="surface-list">
              {sampleFortune.dontList.map((item) => (
                <li><p class="body-sm">{item}</p></li>
              ))}
            </ul>
          </Panel>
        </div>
      </Panel>

      <Panel as="article" padding="lg">
        <h3 class="title-3">Rules and disclaimer</h3>
        <ul class="surface-list">
          <li>
            <p class="mono-label">Entertainment only</p>
            <p class="body-sm">{sampleFortune.disclaimer}</p>
          </li>
          <li>
            <p class="mono-label">Current data shape</p>
            <p class="body-sm">当前以 YAML 数据维护签文等级、权重、宜忌和说明文案。</p>
          </li>
          <li>
            <p class="mono-label">Later direction</p>
            <p class="body-sm">后续再考虑每日固定结果、抽签交互和规则页，而不是现在就夸大功能。</p>
          </li>
        </ul>
      </Panel>
    </div>
  </section>
</BaseLayout>
