---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import Panel from "../../components/ui/Panel.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import {
  formatRadarDate,
  getPublishedRadarEntries,
  getRadarIssuePath,
  getRadarItemImage,
  getRadarWeekRange,
  radarCategoryLabels,
  radarSourceTypeLabels,
  type RadarEntry,
} from "../../lib/radar";
import { siteRoutes, withBase } from "../../lib/routes";

export const getStaticPaths = (async () => {
  const entries = await getPublishedRadarEntries();

  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: RadarEntry;
}

const { entry } = Astro.props as Props;
const { Content } = await entry.render();
const reviewedDate = entry.data.reviewed_at ? formatRadarDate(entry.data.reviewed_at) : null;
const weekRange = getRadarWeekRange(entry);
---

<BaseLayout
  active="radar"
  title={`${entry.data.title} | GitHub Page / AI Infra & Codex Lab`}
  description={entry.data.summary}
>
  <section class="section page-intro">
    <div class="hero-copy">
      <div class="cluster">
        <Badge tone="accent">{entry.data.week_label}</Badge>
        <Badge tone="success">本期周报</Badge>
        <Badge>{weekRange}</Badge>
        <Badge>{formatRadarDate(entry.data.published_at)}</Badge>
      </div>
      <div class="stack">
        <p class="eyebrow">Weekly AI Infra Radar / 本期速读</p>
        <h1 class="title-display">{entry.data.title}</h1>
        <p class="body-lg">{entry.data.summary}</p>
      </div>
      <div class="action-row">
        <Button href={withBase(siteRoutes.radar)} variant="secondary">返回 Radar 列表</Button>
        <Button href="#issue-items" variant="ghost">直接看重点</Button>
      </div>
    </div>

    <div class="page-intro__rail">
      <Panel tone="accent" padding="lg">
        <p class="mono-label">Reading note</p>
        <div class="detail-list">
          <div>
            <p class="mono-label">本期主线</p>
            <p class="body-sm">{entry.data.hero_note}</p>
          </div>
          <div>
            <p class="mono-label">整理时间</p>
            <p class="body-sm">
              {formatRadarDate(entry.data.published_at)}
              {reviewedDate && ` · 更新于 ${reviewedDate}`}
            </p>
          </div>
          <div>
            <p class="mono-label">关键词</p>
            <div class="cluster">
              {entry.data.topics.map((topic) => (
                <Badge>{topic}</Badge>
              ))}
            </div>
          </div>
        </div>
      </Panel>
    </div>
  </section>

  <section class="section">
    <SectionHeader
      eyebrow="Quick Read"
      title={entry.data.hero_note}
      description="这一段适合先扫一遍：知道本周热闹在哪，再决定哪些来源值得点开。"
    />

    <div class="split-grid">
      <Panel as="article" padding="lg">
        <div class="markdown-body">
          <Content />
        </div>
      </Panel>

      <Panel as="article" padding="lg">
        <h3 class="title-3">读前小抄</h3>
        <ul class="surface-list">
          <li>
            <p class="mono-label">先抓主线</p>
            <p class="body-sm">这期通常只有一两条真正的主线，其余新闻都在帮它补上下文。</p>
          </li>
          <li>
            <p class="mono-label">再看影响</p>
            <p class="body-sm">别只看发布了什么，更要看它会不会改模型选择、云采购、成本或安全流程。</p>
          </li>
          <li>
            <p class="mono-label">最后留个问号</p>
            <p class="body-sm">每条都留了观察点，方便下周回来看看谁兑现了，谁只是声音很大。</p>
          </li>
        </ul>
      </Panel>
    </div>
  </section>

  <section class="section" id="issue-items">
    <SectionHeader
      eyebrow="Radar Picks"
      title={`${entry.data.items.length} 条本期重点`}
      description="每条都尽量回答三个问题：发生了什么、为什么重要、接下来盯哪里。"
    />

    <div class="issue-list">
      {entry.data.items.map((item) => (
        <Panel as="article" padding="lg" class="issue-card">
          <div class="callout-row">
            <Badge tone="accent">{radarCategoryLabels[item.category]}</Badge>
            <Badge>{radarSourceTypeLabels[item.source_type]}</Badge>
            <Badge tone={item.credibility === "high" ? "success" : item.credibility === "medium" ? "warning" : "danger"}>
              可信度 {item.credibility}
            </Badge>
          </div>
          <div class="radar-item-layout">
            <div class="radar-item-media" aria-label={getRadarItemImage(item).alt}>
              {getRadarItemImage(item).url ? (
                <img src={getRadarItemImage(item).url ?? ""} alt={getRadarItemImage(item).alt} loading="lazy" />
              ) : (
                <span>{radarCategoryLabels[item.category]}</span>
              )}
            </div>
            <div class="stack">
              <h3 class="title-3">{item.title}</h3>
              <div class="issue-card__meta">
                <span>{item.source_name}</span>
                <span>{formatRadarDate(item.published_at)}</span>
              </div>
              <p class="body-md">{item.summary}</p>
            </div>
          </div>
          <div class="analysis-grid">
            <Panel tone="subtle">
              <p class="mono-label">背景</p>
              <p class="body-sm">{item.background ?? item.summary}</p>
            </Panel>
            <Panel tone="subtle">
              <p class="mono-label">发生了什么</p>
              <p class="body-sm">{item.details ?? item.why_it_matters}</p>
            </Panel>
            <Panel tone="subtle">
              <p class="mono-label">为什么值得看</p>
              <p class="body-sm">{item.impact ?? item.why_it_matters}</p>
            </Panel>
            <Panel tone="subtle">
              <p class="mono-label">继续观察</p>
              {item.watch_points.length > 0 ? (
                <ul class="compact-list">
                  {item.watch_points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              ) : (
                <p class="body-sm">继续关注后续官方更新、工程验证和生态迁移成本。</p>
              )}
            </Panel>
          </div>
          <div class="cluster">
            {item.tags.map((tag) => (
              <Badge>{tag}</Badge>
            ))}
          </div>
          <div class="callout-row">
            <a
              href={item.source_url}
              target="_blank"
              rel="noreferrer"
              class="body-sm source-link"
            >
              查看来源
            </a>
            <span class="caption">重要性：{item.importance}</span>
          </div>
          {item.image_source_url && (
            <p class="caption">
              图片来源：<a href={item.image_source_url} target="_blank" rel="noreferrer" class="source-link">官方或公开来源</a>
            </p>
          )}
          {item.review_notes && (
            <p class="caption">补充说明：{item.review_notes}</p>
          )}
        </Panel>
      ))}
    </div>

    <div class="action-row">
      <Button href={getRadarIssuePath(entry.slug)} variant="ghost">复制本期入口</Button>
      <Button href={withBase(siteRoutes.radar)} variant="secondary">查看全部期号</Button>
    </div>
  </section>
</BaseLayout>
