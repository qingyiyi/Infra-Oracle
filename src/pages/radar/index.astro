---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import Panel from "../../components/ui/Panel.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import {
  formatRadarDate,
  getPublishedRadarEntries,
  getRadarIssuePath,
  getRadarHighlights,
  getRadarWeekRange,
} from "../../lib/radar";
import { siteRoutes, withBase } from "../../lib/routes";

const radarEntries = await getPublishedRadarEntries();
const latestRadar = radarEntries[0];
const latestDate = latestRadar ? formatRadarDate(latestRadar.data.published_at) : null;
const latestHighlights = latestRadar ? getRadarHighlights(latestRadar, 5) : [];
const latestWeekRange = latestRadar ? getRadarWeekRange(latestRadar) : null;
---

<BaseLayout
  active="radar"
  title="Radar | GitHub Page / AI Infra & Codex Lab"
  description="Weekly AI Infra Radar 的当前期号、边界和后续归档方向。"
>
  <section class="section page-intro">
    <div class="hero-copy">
      <div class="cluster">
        <Badge tone="accent">Radar</Badge>
        <Badge tone="success">human-reviewed</Badge>
        {latestDate && <Badge>{latestDate}</Badge>}
      </div>
      <div class="stack">
        <p class="eyebrow">Weekly AI Infra Radar</p>
        <h1 class="title-display">已发布 issue 的归档面，候选与审查流不直接暴露到前台。</h1>
        <p class="body-lg">
          这里承接已发布期号列表、当前期号入口和 Radar 的结构化阅读方式。自动抓取最多只生成候选，真正公开的内容仍然以人工审查后的 issue 为准。
        </p>
      </div>
      <div class="action-row">
        <Button href={withBase(siteRoutes.home)} variant="secondary">返回首页</Button>
        <Button href="#published-issues" variant="ghost">查看已发布期号</Button>
      </div>
    </div>

    <div class="page-intro__rail">
      <Panel tone="accent" padding="lg">
        <p class="mono-label">Current surface</p>
        <h2 class="title-2">Published issues only, human review required, archive-ready.</h2>
        <p class="body-sm">
          首版重点是把 issue 级元数据、item 级结构化字段和发布边界固定下来，为后续归档、筛选和候选流扩展留出空间。
        </p>
      </Panel>
      <div class="stack-grid">
        <Panel tone="subtle">
          <div class="metric">
            <span class="metric__value">{radarEntries.length}</span>
            <span class="metric__label">published issues in the prototype archive</span>
          </div>
        </Panel>
        <Panel tone="subtle">
          <div class="metric">
            <span class="metric__value">{latestRadar ? latestRadar.data.items.length : 0}</span>
            <span class="metric__label">structured items in the latest issue</span>
          </div>
        </Panel>
      </div>
    </div>
  </section>

  <section class="section" id="current-issue">
    <SectionHeader
      eyebrow="Latest Published Issue"
      title={latestRadar ? latestRadar.data.title : "No published issue yet"}
      description="首页只拿最新的 `published` issue 做预览；Radar 主页则负责把期号归档与单期入口组织清楚。"
    />

    <div class="split-grid">
      <Panel as="article" padding="lg">
        <div class="callout-row">
          <Badge tone="accent">{latestRadar ? latestRadar.data.week_label : "draft"}</Badge>
          {latestWeekRange && <Badge>{latestWeekRange}</Badge>}
          {latestRadar && <Badge>{latestRadar.data.editorial_status}</Badge>}
        </div>
        <p class="body-md">
          {latestRadar
            ? latestRadar.data.summary
            : "当内容目录扩展后，这里会承接期号级元数据、编辑导语和主题说明。"}
        </p>
        {latestRadar && (
          <div class="cluster">
            {latestRadar.data.topics.map((topic) => (
              <Badge>{topic}</Badge>
            ))}
          </div>
        )}
        <Panel tone="subtle">
          <p class="mono-label">Editorial note</p>
          <p class="body-sm">
            {latestRadar
              ? latestRadar.data.hero_note
              : "当前尚未发布新的期号内容。"}
          </p>
        </Panel>
        {latestHighlights.length > 0 && (
          <ul class="radar-key-list">
            {latestHighlights.map((item) => (
              <li>
                <span>{item.category}</span>
                <p>{item.title}</p>
              </li>
            ))}
          </ul>
        )}
        {latestRadar && (
          <div class="action-row">
            <Button href={getRadarIssuePath(latestRadar.slug)} variant="primary">进入当前期号</Button>
          </div>
        )}
      </Panel>

      <Panel as="article" padding="lg">
        <h3 class="title-3">Publication boundary</h3>
        <ul class="surface-list">
          <li>
            <p class="mono-label">Human review required</p>
            <p class="body-sm">自动抓取最多只能生成候选，不会直接发布到页面。</p>
          </li>
          <li>
            <p class="mono-label">Static-first issue model</p>
            <p class="body-sm">当前以 Markdown issue + item 数组为主，候选池单独维护，不和公开 issue 混放。</p>
          </li>
          <li>
            <p class="mono-label">Latest issue rule</p>
            <p class="body-sm">首页和 Radar 入口统一读取最新的 `published` issue，而不是隐式依赖文件名或审核中内容。</p>
          </li>
        </ul>
      </Panel>
    </div>
  </section>

  <section class="section" id="published-issues">
    <SectionHeader
      eyebrow="Published Archive"
      title="Every published issue gets a stable detail route."
      description="列表页承接期号归档，detail route 承接 issue 导语和 item-level 结构化条目。"
    />

    <div class="archive-grid">
      {radarEntries.map((entry) => (
        <Panel as="article" padding="lg" class="page-card">
          <div class="callout-row">
            <Badge tone="accent">{entry.data.week_label}</Badge>
            <Badge>{formatRadarDate(entry.data.published_at)}</Badge>
          </div>
          <h3 class="title-3">{entry.data.title}</h3>
          <p class="body-sm">{entry.data.summary}</p>
          <p class="caption">{getRadarWeekRange(entry)}</p>
          <div class="cluster">
            {entry.data.topics.map((topic) => (
              <Badge>{topic}</Badge>
            ))}
          </div>
          <div class="callout-row issue-card__meta">
            <span>{entry.data.editor_name}</span>
            <span>{entry.data.items.length} items</span>
          </div>
          <div class="action-row">
            <Button href={getRadarIssuePath(entry.slug)} variant="secondary">查看单期详情</Button>
          </div>
        </Panel>
      ))}
    </div>
  </section>
</BaseLayout>
