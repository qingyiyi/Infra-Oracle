---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import Panel from "../../components/ui/Panel.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import {
  formatRadarDate,
  getPublishedRadarEntries,
  getRadarIssuePath,
  getRadarHighlights,
  getRadarWeekRange,
} from "../../lib/radar";
import { siteRoutes, withBase } from "../../lib/routes";

const radarEntries = await getPublishedRadarEntries();
const latestRadar = radarEntries[0];
const latestDate = latestRadar ? formatRadarDate(latestRadar.data.published_at) : null;
const latestHighlights = latestRadar ? getRadarHighlights(latestRadar, 5) : [];
const latestWeekRange = latestRadar ? getRadarWeekRange(latestRadar) : null;
---

<BaseLayout
  active="radar"
  title="Radar | GitHub Page / AI Infra & Codex Lab"
  description="Weekly AI Infra Radar 的本周速读和往期归档。"
>
  <section class="section page-intro">
    <div class="hero-copy">
      <div class="cluster">
        <Badge tone="accent">Radar</Badge>
        <Badge tone="success">weekly digest</Badge>
        {latestDate && <Badge>{latestDate}</Badge>}
      </div>
      <div class="stack">
        <p class="eyebrow">Weekly AI Infra Radar</p>
        <h1 class="title-display">每周给 AI Infra 圈做一次降噪。</h1>
        <p class="body-lg">
          模型发布、云厂商动作、GPU 供应、agent 工具和少量会影响算力账单的国际新闻。我们不追每一条热搜，只追那些下周可能还会影响你的东西。
        </p>
      </div>
      <div class="action-row">
        <Button href={withBase(siteRoutes.home)} variant="secondary">返回首页</Button>
        <Button href="#published-issues" variant="ghost">翻往期周报</Button>
      </div>
    </div>

    <div class="page-intro__rail">
      <Panel tone="accent" padding="lg">
        <p class="mono-label">This week</p>
        <h2 class="title-2">{latestRadar ? latestRadar.data.hero_note : "先等一等，本周信号还在路上。"}</h2>
        <p class="body-sm">
          如果一条新闻只适合转发但不适合做决定，它大概率不会在这里待太久。这里偏爱能改变模型选择、云架构和工程节奏的信号。
        </p>
      </Panel>
      <div class="stack-grid">
        <Panel tone="subtle">
          <div class="metric">
            <span class="metric__value">{radarEntries.length}</span>
            <span class="metric__label">期周报可回看</span>
          </div>
        </Panel>
        <Panel tone="subtle">
          <div class="metric">
            <span class="metric__value">{latestRadar ? latestRadar.data.items.length : 0}</span>
            <span class="metric__label">条本期重点</span>
          </div>
        </Panel>
      </div>
    </div>
  </section>

  <section class="section" id="current-issue">
    <SectionHeader
      eyebrow="Latest Dispatch"
      title={latestRadar ? latestRadar.data.title : "本周还在加载中"}
      description="先看这一期的主线，再决定要不要点进每条来源细读。"
    />

    <div class="split-grid">
      <Panel as="article" padding="lg">
        <div class="callout-row">
          <Badge tone="accent">{latestRadar ? latestRadar.data.week_label : "draft"}</Badge>
          {latestWeekRange && <Badge>{latestWeekRange}</Badge>}
          {latestRadar && <Badge>{latestRadar.data.editorial_status}</Badge>}
        </div>
        <p class="body-md">
          {latestRadar
            ? latestRadar.data.summary
            : "这一周还没有整理好的周报，先喝口水等一下。"}
        </p>
        {latestRadar && (
          <div class="cluster">
            {latestRadar.data.topics.map((topic) => (
              <Badge>{topic}</Badge>
            ))}
          </div>
        )}
        <Panel tone="subtle">
          <p class="mono-label">Why this week matters</p>
          <p class="body-sm">
            {latestRadar
              ? latestRadar.data.hero_note
              : "当前尚未发布新的期号内容。"}
          </p>
        </Panel>
        {latestHighlights.length > 0 && (
          <ul class="radar-key-list">
            {latestHighlights.map((item) => (
              <li>
                <span>{item.category}</span>
                <p>{item.title}</p>
              </li>
            ))}
          </ul>
        )}
        {latestRadar && (
          <div class="action-row">
            <Button href={getRadarIssuePath(latestRadar.slug)} variant="primary">打开本期全文</Button>
          </div>
        )}
      </Panel>

      <Panel as="article" padding="lg">
        <h3 class="title-3">本周怎么读</h3>
        <ul class="surface-list">
          <li>
            <p class="mono-label">先看模型</p>
            <p class="body-sm">谁发布了新模型、谁把模型塞进云市场，通常决定下个月工具链怎么变。</p>
          </li>
          <li>
            <p class="mono-label">再看算力</p>
            <p class="body-sm">GPU、TPU、推理框架和价格信号，最后都会变成账单、延迟和部署选择。</p>
          </li>
          <li>
            <p class="mono-label">最后看治理</p>
            <p class="body-sm">agent 能不能进企业，往往不是看它多聪明，而是看谁能审计、停用和追责。</p>
          </li>
        </ul>
      </Panel>
    </div>
  </section>

  <section class="section" id="published-issues">
    <SectionHeader
      eyebrow="Archive"
      title="往期周报，适合翻旧账。"
      description="AI 圈的记忆只有七秒，归档负责把上周的热闹留到下次复盘。"
    />

    <div class="archive-grid">
      {radarEntries.map((entry) => (
        <Panel as="article" padding="lg" class="page-card">
          <div class="callout-row">
            <Badge tone="accent">{entry.data.week_label}</Badge>
            <Badge>{formatRadarDate(entry.data.published_at)}</Badge>
          </div>
          <h3 class="title-3">{entry.data.title}</h3>
          <p class="body-sm">{entry.data.summary}</p>
          <p class="caption">{getRadarWeekRange(entry)}</p>
          <div class="cluster">
            {entry.data.topics.map((topic) => (
              <Badge>{topic}</Badge>
            ))}
          </div>
          <div class="callout-row issue-card__meta">
            <span>{entry.data.editor_name}</span>
            <span>{entry.data.items.length} 条重点</span>
          </div>
          <div class="action-row">
            <Button href={getRadarIssuePath(entry.slug)} variant="secondary">读这一期</Button>
          </div>
        </Panel>
      ))}
    </div>
  </section>
</BaseLayout>
