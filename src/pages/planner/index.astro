---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import Panel from "../../components/ui/Panel.astro";
import {
  defaultPlannerTasks,
  getPlannerDayTaskLayout,
  getPlannerPayload,
  getPlannerTaskType,
  getTaskCompactTimeRangeText,
  getTaskPosition,
  getTaskTimeRangeText,
  plannerDays,
  plannerHourTicks,
  plannerTaskTypes,
} from "../../lib/planner";
import { siteRoutes, withBase } from "../../lib/routes";

const plannerPayload = JSON.stringify(getPlannerPayload()).replace(/</g, "\\u003c");
---

<BaseLayout
  active="planner"
  title="Planner | GitHub Page / AI Infra & Codex Lab"
  description="编辑本周通勤、工作、上课、项目和生活安排的时间轴日程。"
>
  <section class="section page-intro planner-hero" data-planner-app>
    <div class="hero-copy">
      <div class="cluster">
        <Badge tone="accent">Weekly Planner</Badge>
        <Badge tone="success">06:00-24:00</Badge>
        <Badge>1 min</Badge>
      </div>

      <div class="stack">
        <p class="eyebrow">Week / Time / Tiny Life</p>
        <h1 class="title-display">本周时间表</h1>
        <p class="body-lg">
          把通勤、工作、上课和自己的时间放在同一张图里。严肃的事排清楚，轻松的事也要有位置。
        </p>
      </div>

      <div class="action-row">
        <Button href={withBase(siteRoutes.home)} variant="secondary">返回首页</Button>
        <Button href="#planner-editor" variant="ghost">编辑本周</Button>
      </div>
    </div>

    <Panel as="aside" tone="accent" padding="lg" class="planner-note-card">
      <p class="mono-label">This week</p>
      <h2 class="title-2">让一周看起来没那么像一团毛线。</h2>
      <p class="body-sm">
        早上六点到午夜，七天横着铺开。通勤、课程、工作和项目都放上去，剩下的空格就留给电影、小说和真正的休息。
      </p>
    </Panel>
  </section>

  <section class="section planner-workspace">
    <Panel as="section" padding="lg" class="planner-board-card">
      <div class="home-surface__header">
        <div class="section-header__copy">
          <p class="eyebrow">Week Board</p>
          <h2 class="title-1">这一周怎么过</h2>
          <p class="body-md" data-planner-week-range>每一行是一整天，横向位置对应当天的具体时间。</p>
        </div>
        <div class="cluster">
          <Badge tone="accent" data-planner-count>{defaultPlannerTasks.length} items</Badge>
          <Badge data-planner-week-label>本周</Badge>
        </div>
      </div>

      <div class="planner-week-switcher" aria-label="切换 Planner 周">
        <button type="button" class="button button--ghost button--sm" data-planner-week-prev>上一周</button>
        <button type="button" class="button button--secondary button--sm" data-planner-week-today>回到本周</button>
        <button type="button" class="button button--ghost button--sm" data-planner-week-next>下一周</button>
      </div>

      <div class="planner-time-board" data-planner-board>
        <div class="planner-time-board__header" aria-hidden="true">
          <span class="planner-time-board__corner">Day</span>
          <div class="planner-time-axis">
            {plannerHourTicks.map((tick, index) => (
              <span style={`--tick-left: ${(index / (plannerHourTicks.length - 1)) * 100}%;`}>{tick}</span>
            ))}
          </div>
        </div>

        <div class="planner-time-board__rows" data-planner-rows>
          {plannerDays.map((day) => {
            const layout = getPlannerDayTaskLayout(defaultPlannerTasks.filter((task) => task.day === day.index));
            return (
              <section class="planner-day-row" data-day-row={day.index}>
                <div class="planner-day-label">
                  <strong>{day.label}</strong>
                  <span>{day.shortLabel}</span>
                </div>
                <div class="planner-day-track" style={`--lane-count: ${layout.laneCount};`}>
                  {layout.items.map(({ task, laneIndex }) => {
                    const type = getPlannerTaskType(task.type);
                    const position = getTaskPosition(task);
                    return (
                      <button
                        type="button"
                        class="planner-task-bar"
                        data-task-id={task.id}
                        aria-label={`编辑或拖动调整 ${task.title}，${getTaskTimeRangeText(task)}`}
                        title={`${getTaskTimeRangeText(task)} · ${type.label}${task.note ? ` · ${task.note}` : ""}`}
                        style={`--task-left: ${position.left}%; --task-width: ${position.width}%; --task-top: ${laneIndex}; --task-color: ${type.color};`}
                      >
                        <i class="planner-task-handle planner-task-handle--start" data-planner-drag-handle="start" aria-hidden="true"></i>
                        <span>{task.title}</span>
                        <em>{getTaskCompactTimeRangeText(task)}</em>
                        <i class="planner-task-handle planner-task-handle--end" data-planner-drag-handle="end" aria-hidden="true"></i>
                      </button>
                    );
                  })}
                </div>
              </section>
            );
          })}
        </div>
      </div>

      <div class="planner-mobile-list" data-planner-mobile-list>
        {plannerDays.map((day) => (
          <section class="planner-mobile-day">
            <h3>{day.label}</h3>
            {defaultPlannerTasks.filter((task) => task.day === day.index).map((task) => {
              const type = getPlannerTaskType(task.type);
              return (
                <button
                  type="button"
                  class="planner-mobile-item"
                  style={`--task-color: ${type.color};`}
                  data-task-id={task.id}
                  aria-label={`编辑 ${task.title}，${getTaskTimeRangeText(task)}`}
                >
                  <div>
                    <strong>{task.title}</strong>
                    <span>{getTaskTimeRangeText(task)} · {task.note}</span>
                  </div>
                  <em>{type.label}</em>
                </button>
              );
            })}
          </section>
        ))}
      </div>
    </Panel>

    <div class="planner-edit-grid" id="planner-editor">
      <Panel as="section" padding="lg" class="planner-editor-card">
        <div class="home-surface__header">
          <div class="section-header__copy">
            <p class="eyebrow">Edit</p>
            <h2 class="title-2" data-planner-form-title>新增安排</h2>
          </div>
          <button type="button" class="button button--ghost button--sm" data-planner-reset>恢复示例</button>
        </div>

        <form class="planner-form" data-planner-form>
          <input type="hidden" name="id" data-planner-id />
          <label class="field">
            <span class="field__label">标题</span>
            <input class="field__control" name="title" maxlength="60" placeholder="比如：读论文 / 改图表 / 看电影" required />
          </label>

          <div class="form-grid">
            <label class="field">
              <span class="field__label">类型</span>
              <select class="field__control" name="type">
                {plannerTaskTypes.map((type) => (
                  <option value={type.id}>{type.label}</option>
                ))}
              </select>
            </label>

            <label class="field">
              <span class="field__label">星期</span>
              <select class="field__control" name="day">
                {plannerDays.map((day) => (
                  <option value={day.index}>{day.label}</option>
                ))}
              </select>
            </label>

            <label class="field">
              <span class="field__label">开始时间</span>
              <input class="field__control" name="startTime" inputmode="numeric" maxlength="5" placeholder="08:00" required />
            </label>

            <label class="field">
              <span class="field__label">结束时间</span>
              <input class="field__control" name="endTime" inputmode="numeric" maxlength="5" placeholder="10:00" required />
            </label>
          </div>

          <label class="field">
            <span class="field__label">备注</span>
            <textarea class="field__control" name="note" maxlength="120" rows="3" placeholder="一句话提醒自己，不要写成长篇计划。"></textarea>
          </label>

          <p class="planner-form__message" data-planner-message role="status"></p>

          <div class="action-row">
            <Button type="submit" variant="primary">保存</Button>
            <button type="button" class="button button--secondary button--md" data-planner-cancel>取消编辑</button>
            <button type="button" class="button button--ghost button--md" data-planner-delete>删除当前</button>
          </div>
        </form>
      </Panel>

      <Panel as="section" tone="subtle" padding="lg" class="planner-type-card">
        <p class="mono-label">Task types</p>
        <h2 class="title-3">工作要有格子，摸鱼也可以有姓名。</h2>
        <div class="planner-type-grid">
          {plannerTaskTypes.map((type) => (
            <button type="button" class="planner-type-chip" style={`--task-color: ${type.color};`} data-planner-type={type.id}>
              <span></span>
              {type.label}
            </button>
          ))}
        </div>
      </Panel>

      <Panel as="section" tone="subtle" padding="lg" class="planner-transfer-card">
        <p class="mono-label">Backup</p>
        <h2 class="title-3">把这周先存一份。</h2>
        <p class="body-sm">
          导出 JSON 可以换浏览器或换设备时导入。导入会覆盖当前浏览器里的本周计划。
        </p>
        <div class="action-row">
          <button type="button" class="button button--secondary button--md" data-planner-export>导出 JSON</button>
          <button type="button" class="button button--ghost button--md" data-planner-import>导入 JSON</button>
        </div>
        <input type="file" accept="application/json,.json" data-planner-import-file hidden />
      </Panel>
    </div>

    <script is:inline type="application/json" data-planner-data set:html={plannerPayload}></script>
    <script is:inline>
      (() => {
        const app = document.querySelector("[data-planner-app]");
        const dataNode = document.querySelector("[data-planner-data]");
        const rows = document.querySelector("[data-planner-rows]");
        const mobileList = document.querySelector("[data-planner-mobile-list]");
        const count = document.querySelector("[data-planner-count]");
        const weekLabel = document.querySelector("[data-planner-week-label]");
        const weekRange = document.querySelector("[data-planner-week-range]");
        const weekPrevButton = document.querySelector("[data-planner-week-prev]");
        const weekTodayButton = document.querySelector("[data-planner-week-today]");
        const weekNextButton = document.querySelector("[data-planner-week-next]");
        const form = document.querySelector("[data-planner-form]");
        const formTitle = document.querySelector("[data-planner-form-title]");
        const message = document.querySelector("[data-planner-message]");
        const cancelButton = document.querySelector("[data-planner-cancel]");
        const deleteButton = document.querySelector("[data-planner-delete]");
        const resetButton = document.querySelector("[data-planner-reset]");
        const exportButton = document.querySelector("[data-planner-export]");
        const importButton = document.querySelector("[data-planner-import]");
        const importFileInput = document.querySelector("[data-planner-import-file]");
        const typeButtons = document.querySelectorAll("[data-planner-type]");

        if (!app || !dataNode || !rows || !mobileList || !form) return;

        let payload;

        try {
          payload = JSON.parse(dataNode.textContent || "{}");
        } catch {
          return;
        }

        const days = Array.isArray(payload.days) ? payload.days : [];
        const types = Array.isArray(payload.taskTypes) ? payload.taskTypes : [];
        const defaultTasks = Array.isArray(payload.defaultTasks) ? payload.defaultTasks : [];
        const typeMap = new Map(types.map((type) => [type.id, type]));
        const storageKey = payload.storageKey || "infra-oracle.weekly-planner.v2";
        const weekStoragePrefix = payload.weekStoragePrefix || "infra-oracle.weekly-planner.v3.week";
        const exportSchema = payload.exportSchema || "infra-oracle.weekly-planner.export";
        const exportVersion = Number(payload.exportVersion || 1);
        const startMinute = Number(payload.startMinute || 360);
        const endMinute = Number(payload.endMinute || 1440);
        const totalMinutes = endMinute - startMinute;
        const dragSnapMinutes = 15;
        const dragThresholdPx = 4;
        const minDragDurationMinutes = 15;
        let tasks = [];
        let activeDrag = null;
        let suppressedClick = { taskId: "", until: 0 };
        let selectedWeekStart = startOfWeek(new Date());
        let selectedWeekKey = formatDateKey(selectedWeekStart);
        tasks = loadTasks();

        function clampDay(value) {
          const number = Number(value);
          if (!Number.isFinite(number)) return 0;
          return Math.max(0, Math.min(6, Math.trunc(number)));
        }

        function timeToMinutes(value) {
          const match = String(value || "").trim().match(/^(\d{1,2}):(\d{2})$/);
          if (!match) return null;
          const hours = Number(match[1]);
          const minutes = Number(match[2]);
          if (!Number.isInteger(hours) || !Number.isInteger(minutes)) return null;
          if (hours < 0 || hours > 24 || minutes < 0 || minutes > 59) return null;
          if (hours === 24 && minutes !== 0) return null;
          return hours * 60 + minutes;
        }

        function minutesToTime(value) {
          const minutes = Math.max(0, Math.min(24 * 60, Math.trunc(value)));
          const hoursPart = Math.trunc(minutes / 60);
          const minutesPart = minutes % 60;
          return `${String(hoursPart).padStart(2, "0")}:${String(minutesPart).padStart(2, "0")}`;
        }

        function startOfWeek(date) {
          const next = new Date(date);
          next.setHours(0, 0, 0, 0);
          const day = next.getDay();
          const diff = day === 0 ? -6 : 1 - day;
          next.setDate(next.getDate() + diff);
          return next;
        }

        function shiftWeek(date, offset) {
          const next = new Date(date);
          next.setDate(next.getDate() + offset * 7);
          return startOfWeek(next);
        }

        function formatDateKey(date) {
          const year = date.getFullYear();
          const month = String(date.getMonth() + 1).padStart(2, "0");
          const day = String(date.getDate()).padStart(2, "0");
          return `${year}-${month}-${day}`;
        }

        function formatShortDate(date) {
          return `${date.getMonth() + 1}/${date.getDate()}`;
        }

        function weekStorageKey(weekKey = selectedWeekKey) {
          return `${weekStoragePrefix}.${weekKey}`;
        }

        function currentWeekKey() {
          return formatDateKey(startOfWeek(new Date()));
        }

        function getWeekLabel() {
          const current = currentWeekKey();
          if (selectedWeekKey === current) return "本周";
          return selectedWeekKey < current ? "过去周" : "未来周";
        }

        function getWeekRangeText() {
          const weekEnd = new Date(selectedWeekStart);
          weekEnd.setDate(weekEnd.getDate() + 6);
          return `${formatShortDate(selectedWeekStart)}-${formatShortDate(weekEnd)} · ${selectedWeekKey}`;
        }

        function snapMinutes(value) {
          return Math.round(value / dragSnapMinutes) * dragSnapMinutes;
        }

        function normalizeTime(value, fallback) {
          const minutes = timeToMinutes(value);
          if (minutes === null) return minutesToTime(fallback);
          return minutesToTime(Math.max(startMinute, Math.min(endMinute, minutes)));
        }

        function normalizeTask(task, index = 0) {
          if (!task || typeof task !== "object") return null;
          const title = String(task.title || "").trim().slice(0, 60);
          if (!title) return null;

          const start = Math.max(
            startMinute,
            Math.min(endMinute - 1, timeToMinutes(normalizeTime(task.startTime, startMinute)) ?? startMinute),
          );
          const end = Math.max(start + 1, Math.min(endMinute, timeToMinutes(normalizeTime(task.endTime, start + 60)) ?? start + 60));

          return {
            id: String(task.id || `task-${index + 1}`).replace(/[^a-zA-Z0-9_-]+/g, "-").slice(0, 80),
            title,
            type: typeMap.has(task.type) ? task.type : "custom",
            day: clampDay(task.day),
            startTime: minutesToTime(start),
            endTime: minutesToTime(end),
            note: String(task.note || "").trim().slice(0, 120),
          };
        }

        function normalizeTasks(rawTasks) {
          const next = Array.isArray(rawTasks)
            ? rawTasks.map(normalizeTask).filter(Boolean)
            : defaultTasks.map(normalizeTask).filter(Boolean);
          return next.slice().sort((a, b) =>
            a.day - b.day ||
            (timeToMinutes(a.startTime) || startMinute) - (timeToMinutes(b.startTime) || startMinute) ||
            (timeToMinutes(a.endTime) || endMinute) - (timeToMinutes(b.endTime) || endMinute) ||
            a.title.localeCompare(b.title)
          );
        }

        function loadTasks() {
          try {
            const weekValue = window.localStorage.getItem(weekStorageKey());
            if (weekValue !== null) return normalizeTasks(JSON.parse(weekValue));
            if (selectedWeekKey === currentWeekKey()) {
              const legacyValue = window.localStorage.getItem(storageKey);
              if (legacyValue !== null) {
                const migrated = normalizeTasks(JSON.parse(legacyValue));
                window.localStorage.setItem(weekStorageKey(), JSON.stringify(migrated));
                return migrated;
              }
              return normalizeTasks(defaultTasks);
            }
            return [];
          } catch {
            return selectedWeekKey === currentWeekKey() ? normalizeTasks(defaultTasks) : [];
          }
        }

        function saveTasks() {
          window.localStorage.setItem(weekStorageKey(), JSON.stringify(tasks));
        }

        function getPlannerExportPayload() {
          const weekEnd = new Date(selectedWeekStart);
          weekEnd.setDate(weekEnd.getDate() + 6);
          return {
            schema: exportSchema,
            version: exportVersion,
            exportedAt: new Date().toISOString(),
            app: "Infra-Oracle Weekly Planner",
            storageKey,
            weekStoragePrefix,
            weekKey: selectedWeekKey,
            weekStart: selectedWeekKey,
            weekEnd: formatDateKey(weekEnd),
            timeWindow: {
              start: minutesToTime(startMinute),
              end: minutesToTime(endMinute),
            },
            tasks,
          };
        }

        function getExportFileName() {
          return `infra-oracle-planner-${selectedWeekKey}.json`;
        }

        function downloadTextFile(fileName, content, mimeType = "application/json") {
          const blob = new Blob([content], { type: `${mimeType};charset=utf-8` });
          const url = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.href = url;
          link.download = fileName;
          link.style.display = "none";
          document.body.append(link);
          link.click();
          link.remove();
          URL.revokeObjectURL(url);
        }

        function getImportTaskSource(parsed) {
          if (Array.isArray(parsed)) return parsed;
          if (!parsed || typeof parsed !== "object") return null;
          if (parsed.schema && parsed.schema !== exportSchema) return null;
          if (parsed.version && Number(parsed.version) > exportVersion) return null;
          return Array.isArray(parsed.tasks) ? parsed.tasks : null;
        }

        function importPlannerJson(text) {
          let parsed;
          try {
            parsed = JSON.parse(text);
          } catch {
            throw new Error("这个 JSON 解析失败了。");
          }

          const rawTasks = getImportTaskSource(parsed);
          if (!rawTasks) {
            throw new Error("没有找到可导入的 Planner tasks，或文件版本暂不支持。");
          }

          const nextTasks = normalizeTasks(rawTasks);
          if (!nextTasks.length) {
            throw new Error("文件里没有可用安排。");
          }

          return nextTasks;
        }

        function switchWeek(nextWeekStart) {
          selectedWeekStart = startOfWeek(nextWeekStart);
          selectedWeekKey = formatDateKey(selectedWeekStart);
          tasks = loadTasks();
          activeDrag = null;
          suppressedClick = { taskId: "", until: 0 };
          resetForm();
          render();
          setMessage(`已切换到 ${getWeekRangeText()}。`);
        }

        function taskType(task) {
          return typeMap.get(task.type) || typeMap.get("custom") || { label: "自定义", color: "#c7cad2" };
        }

        function timeRangeText(task) {
          return `${task.startTime}-${task.endTime}`;
        }

        function compactTimeText(value) {
          return String(value || "")
            .replace(/^0?(\d{1,2}):00$/, "$1")
            .replace(/^0?(\d{1,2}):(\d{2})$/, "$1:$2");
        }

        function compactTimeRangeText(task) {
          return `${compactTimeText(task.startTime)}-${compactTimeText(task.endTime)}`;
        }

        function setMessage(text, tone = "") {
          if (!message) return;
          message.textContent = text || "";
          message.dataset.tone = tone;
        }

        function taskPosition(task) {
          const start = Math.max(startMinute, Math.min(endMinute, timeToMinutes(task.startTime) ?? startMinute));
          const end = Math.max(start + 1, Math.min(endMinute, timeToMinutes(task.endTime) ?? endMinute));
          return {
            left: ((start - startMinute) / totalMinutes) * 100,
            width: ((end - start) / totalMinutes) * 100,
          };
        }

        function dayFromPointerY(clientY, fallbackDay) {
          const rowsByDay = [...rows.querySelectorAll("[data-day-row]")]
            .map((row) => ({
              day: clampDay(row.dataset.dayRow),
              rect: row.getBoundingClientRect(),
            }))
            .filter(({ rect }) => rect.height > 0);

          const directHit = rowsByDay.find(({ rect }) => clientY >= rect.top && clientY <= rect.bottom);
          if (directHit) return directHit.day;
          if (!rowsByDay.length) return fallbackDay;

          return rowsByDay
            .map((entry) => ({
              ...entry,
              distance: Math.abs(clientY - (entry.rect.top + entry.rect.height / 2)),
            }))
            .sort((left, right) => left.distance - right.distance)[0].day;
        }

        function updateTaskFromDrag(taskId, nextDay, nextStart, nextEnd) {
          tasks = normalizeTasks(tasks.map((task) =>
            task.id === taskId
              ? {
                  ...task,
                  day: clampDay(nextDay),
                  startTime: minutesToTime(nextStart),
                  endTime: minutesToTime(nextEnd),
                }
              : task
          ));
          saveTasks();
          render();
          syncEditingForm(taskId);
        }

        function syncEditingForm(taskId) {
          if (String(form.elements.id.value || "") !== taskId) return;
          const task = tasks.find((item) => item.id === taskId);
          if (!task) return;
          form.elements.day.value = String(task.day);
          form.elements.startTime.value = task.startTime;
          form.elements.endTime.value = task.endTime;
          setMessage(`已调整：${days[task.day]?.label || "这天"} ${timeRangeText(task)} · ${task.title}`, "success");
        }

        function startTaskDrag(event, taskId) {
          if (event.pointerType === "mouse" && event.button !== 0) return;
          const task = tasks.find((item) => item.id === taskId);
          const track = event.currentTarget.closest(".planner-day-track");
          if (!task || !track) return;

          const handle = event.target.closest("[data-planner-drag-handle]");
          const mode = handle?.dataset.plannerDragHandle || "move";
          const originalStart = timeToMinutes(task.startTime) ?? startMinute;
          const originalEnd = timeToMinutes(task.endTime) ?? Math.min(endMinute, originalStart + 60);

          activeDrag = {
            taskId,
            mode,
            trackRect: track.getBoundingClientRect(),
            startClientX: event.clientX,
            startClientY: event.clientY,
            originalDay: task.day,
            originalStart,
            originalEnd,
            didMove: false,
            lastDay: task.day,
            lastStart: originalStart,
            lastEnd: originalEnd,
          };

          document.body.dataset.plannerDragging = "true";
          event.preventDefault();
          window.addEventListener("pointermove", handleTaskDragMove);
          window.addEventListener("pointerup", stopTaskDrag, { once: true });
          window.addEventListener("pointercancel", cancelTaskDrag, { once: true });
        }

        function handleTaskDragMove(event) {
          if (!activeDrag) return;
          const xDelta = event.clientX - activeDrag.startClientX;
          const yDelta = event.clientY - activeDrag.startClientY;
          if (!activeDrag.didMove && Math.abs(xDelta) < dragThresholdPx && Math.abs(yDelta) < dragThresholdPx) return;
          activeDrag.didMove = true;

          const duration = activeDrag.originalEnd - activeDrag.originalStart;
          const minuteDelta = snapMinutes((xDelta / Math.max(1, activeDrag.trackRect.width)) * totalMinutes);
          let nextDay = activeDrag.mode === "move" ? dayFromPointerY(event.clientY, activeDrag.originalDay) : activeDrag.originalDay;
          let nextStart = activeDrag.originalStart;
          let nextEnd = activeDrag.originalEnd;

          if (activeDrag.mode === "start") {
            nextStart = Math.max(startMinute, Math.min(activeDrag.originalEnd - minDragDurationMinutes, activeDrag.originalStart + minuteDelta));
          } else if (activeDrag.mode === "end") {
            nextEnd = Math.max(activeDrag.originalStart + minDragDurationMinutes, Math.min(endMinute, activeDrag.originalEnd + minuteDelta));
          } else {
            const clampedStart = Math.max(startMinute, Math.min(endMinute - duration, activeDrag.originalStart + minuteDelta));
            nextStart = clampedStart;
            nextEnd = clampedStart + duration;
          }

          if (nextDay === activeDrag.lastDay && nextStart === activeDrag.lastStart && nextEnd === activeDrag.lastEnd) return;
          activeDrag.lastDay = nextDay;
          activeDrag.lastStart = nextStart;
          activeDrag.lastEnd = nextEnd;
          updateTaskFromDrag(activeDrag.taskId, nextDay, nextStart, nextEnd);
        }

        function stopTaskDrag() {
          if (!activeDrag) return;
          const finishedDrag = activeDrag;
          window.removeEventListener("pointermove", handleTaskDragMove);
          window.removeEventListener("pointercancel", cancelTaskDrag);
          delete document.body.dataset.plannerDragging;

          if (finishedDrag.didMove) {
            suppressedClick = { taskId: finishedDrag.taskId, until: Date.now() + 450 };
            const task = tasks.find((item) => item.id === finishedDrag.taskId);
            if (task) setMessage(`已调整：${days[task.day]?.label || "这天"} ${timeRangeText(task)} · ${task.title}`, "success");
          }

          activeDrag = null;
          render();
        }

        function cancelTaskDrag() {
          if (!activeDrag) return;
          window.removeEventListener("pointermove", handleTaskDragMove);
          window.removeEventListener("pointerup", stopTaskDrag);
          delete document.body.dataset.plannerDragging;
          activeDrag = null;
          render();
        }

        function resetForm() {
          form.reset();
          form.elements.id.value = "";
          form.elements.type.value = "work";
          form.elements.day.value = "0";
          form.elements.startTime.value = "10:00";
          form.elements.endTime.value = "12:00";
          if (formTitle) formTitle.textContent = "新增安排";
          if (deleteButton) deleteButton.disabled = true;
          setMessage("");
        }

        function editTask(id) {
          const task = tasks.find((item) => item.id === id);
          if (!task) return;
          form.elements.id.value = task.id;
          form.elements.title.value = task.title;
          form.elements.type.value = task.type;
          form.elements.day.value = String(task.day);
          form.elements.startTime.value = task.startTime;
          form.elements.endTime.value = task.endTime;
          form.elements.note.value = task.note || "";
          if (formTitle) formTitle.textContent = "编辑安排";
          if (deleteButton) deleteButton.disabled = false;
          setMessage(`正在编辑：${days[task.day]?.label || "这天"} ${timeRangeText(task)} · ${task.title}`);
          form.scrollIntoView({ behavior: "smooth", block: "center" });
        }

        function getDayTaskLayout(dayTasks) {
          const sorted = dayTasks.slice().sort((a, b) =>
            (timeToMinutes(a.startTime) || startMinute) - (timeToMinutes(b.startTime) || startMinute) ||
            (timeToMinutes(a.endTime) || endMinute) - (timeToMinutes(b.endTime) || endMinute) ||
            a.title.localeCompare(b.title)
          );
          const laneEnds = [];
          const items = sorted.map((task) => {
            const start = timeToMinutes(task.startTime) || startMinute;
            const end = timeToMinutes(task.endTime) || endMinute;
            let laneIndex = laneEnds.findIndex((laneEnd) => laneEnd <= start);

            if (laneIndex === -1) {
              laneIndex = laneEnds.length;
              laneEnds.push(end);
            } else {
              laneEnds[laneIndex] = end;
            }

            return { task, laneIndex };
          });
          return { items, laneCount: Math.max(laneEnds.length, 1) };
        }

        function renderDesktopRows() {
          rows.replaceChildren();

          for (const day of days) {
            const section = document.createElement("section");
            section.className = "planner-day-row";
            section.dataset.dayRow = String(day.index);

            const label = document.createElement("div");
            label.className = "planner-day-label";
            const dayName = document.createElement("strong");
            dayName.textContent = day.label;
            const dayShort = document.createElement("span");
            dayShort.textContent = day.shortLabel;
            label.append(dayName, dayShort);

            const track = document.createElement("div");
            track.className = "planner-day-track";
            const layout = getDayTaskLayout(tasks.filter((task) => task.day === day.index));
            track.style.setProperty("--lane-count", String(layout.laneCount));

            for (const { task, laneIndex } of layout.items) {
              const type = taskType(task);
              const position = taskPosition(task);
              const bar = document.createElement("button");
              bar.type = "button";
              bar.className = "planner-task-bar";
              bar.dataset.taskId = task.id;
              bar.setAttribute("aria-label", `编辑或拖动调整 ${task.title}，${timeRangeText(task)}`);
              bar.title = `${timeRangeText(task)} · ${type.label}${task.note ? ` · ${task.note}` : ""}`;
              bar.style.setProperty("--task-left", `${position.left}%`);
              bar.style.setProperty("--task-width", `${position.width}%`);
              bar.style.setProperty("--task-top", String(laneIndex));
              bar.style.setProperty("--task-color", type.color);
              if (activeDrag?.taskId === task.id) bar.dataset.dragging = "true";
              bar.addEventListener("pointerdown", (event) => startTaskDrag(event, task.id));
              bar.addEventListener("click", (event) => {
                if (suppressedClick.taskId === task.id && Date.now() < suppressedClick.until) {
                  event.preventDefault();
                  event.stopPropagation();
                  return;
                }
                editTask(task.id);
              });

              const startHandle = document.createElement("i");
              startHandle.className = "planner-task-handle planner-task-handle--start";
              startHandle.dataset.plannerDragHandle = "start";
              startHandle.setAttribute("aria-hidden", "true");
              const title = document.createElement("span");
              title.textContent = task.title;
              const meta = document.createElement("em");
              meta.textContent = compactTimeRangeText(task);
              const endHandle = document.createElement("i");
              endHandle.className = "planner-task-handle planner-task-handle--end";
              endHandle.dataset.plannerDragHandle = "end";
              endHandle.setAttribute("aria-hidden", "true");
              bar.append(startHandle, title, meta, endHandle);
              track.append(bar);
            }

            if (!layout.items.length) {
              const empty = document.createElement("p");
              empty.className = "planner-day-empty";
              empty.textContent = "空着也挺好。";
              track.append(empty);
            }

            section.append(label, track);
            rows.append(section);
          }
        }

        function renderMobileList() {
          mobileList.replaceChildren();

          for (const day of days) {
            const dayTasks = tasks.filter((task) => task.day === day.index);
            const section = document.createElement("section");
            section.className = "planner-mobile-day";

            const heading = document.createElement("h3");
            heading.textContent = day.label;
            section.append(heading);

            if (!dayTasks.length) {
              const empty = document.createElement("p");
              empty.className = "planner-empty";
              empty.textContent = "今天留白。";
              section.append(empty);
            }

            for (const task of dayTasks) {
              const type = taskType(task);
              const item = document.createElement("button");
              item.type = "button";
              item.className = "planner-mobile-item";
              item.dataset.taskId = task.id;
              item.setAttribute("aria-label", `编辑 ${task.title}，${timeRangeText(task)}`);
              item.style.setProperty("--task-color", type.color);
              const copy = document.createElement("div");
              const mobileTitle = document.createElement("strong");
              mobileTitle.textContent = task.title;
              const range = document.createElement("span");
              range.textContent = task.note ? `${timeRangeText(task)} · ${task.note}` : timeRangeText(task);
              copy.append(mobileTitle, range);
              const tag = document.createElement("em");
              tag.textContent = type.label;
              item.append(copy, tag);
              item.addEventListener("click", () => editTask(task.id));
              section.append(item);
            }

            mobileList.append(section);
          }
        }

        function render() {
          if (count) count.textContent = `${tasks.length} items`;
          if (weekLabel) weekLabel.textContent = getWeekLabel();
          if (weekRange) weekRange.textContent = `${getWeekRangeText()}。每一行是一整天，横向位置对应当天的具体时间。`;
          renderDesktopRows();
          renderMobileList();
        }

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          const title = String(form.elements.title.value || "").trim();
          const start = timeToMinutes(form.elements.startTime.value);
          const end = timeToMinutes(form.elements.endTime.value);

          if (!title) {
            setMessage("标题不能为空。", "error");
            return;
          }

          if (start === null || end === null) {
            setMessage("时间格式请写成 HH:mm，例如 08:30。", "error");
            return;
          }

          if (start < startMinute || end > endMinute) {
            setMessage("时间需要在 06:00 到 24:00 之间。", "error");
            return;
          }

          if (end <= start) {
            setMessage("结束时间必须晚于开始时间。", "error");
            return;
          }

          const existingId = String(form.elements.id.value || "");
          const task = {
            id: existingId || `task-${Date.now().toString(36)}-${Math.random().toString(16).slice(2, 7)}`,
            title,
            type: form.elements.type.value,
            day: clampDay(form.elements.day.value),
            startTime: minutesToTime(start),
            endTime: minutesToTime(end),
            note: String(form.elements.note.value || "").trim(),
          };
          const normalized = normalizeTask(task);
          if (!normalized) return;

          const successMessage = existingId ? "已更新。" : "已加入当前周。";

          if (existingId) {
            tasks = tasks.map((item) => item.id === existingId ? normalized : item);
          } else {
            tasks = [...tasks, normalized];
          }

          tasks = normalizeTasks(tasks);
          saveTasks();
          render();
          resetForm();
          setMessage(successMessage, "success");
        });

        cancelButton?.addEventListener("click", resetForm);
        deleteButton?.addEventListener("click", () => {
          const id = String(form.elements.id.value || "");
          if (!id) return;
          tasks = tasks.filter((task) => task.id !== id);
          saveTasks();
          render();
          resetForm();
          setMessage("已删除。", "success");
        });
        resetButton?.addEventListener("click", () => {
          tasks = normalizeTasks(defaultTasks);
          saveTasks();
          render();
          resetForm();
          setMessage("当前周示例已恢复。", "success");
        });
        exportButton?.addEventListener("click", () => {
          const content = JSON.stringify(getPlannerExportPayload(), null, 2);
          downloadTextFile(getExportFileName(), content);
          setMessage("已导出 JSON。", "success");
        });
        importButton?.addEventListener("click", () => {
          importFileInput?.click();
        });
        importFileInput?.addEventListener("change", async () => {
          const file = importFileInput.files?.[0];
          importFileInput.value = "";
          if (!file) return;

          if (!file.name.toLowerCase().endsWith(".json")) {
            setMessage("请选择 .json 文件。", "error");
            return;
          }

          let nextTasks;
          try {
            nextTasks = importPlannerJson(await file.text());
          } catch (error) {
            setMessage(error instanceof Error ? error.message : "导入失败。", "error");
            return;
          }

          const confirmed = window.confirm(`导入后会覆盖当前 ${tasks.length} 条安排，改为文件里的 ${nextTasks.length} 条。继续吗？`);
          if (!confirmed) {
            setMessage("已取消导入。");
            return;
          }

          tasks = nextTasks;
          saveTasks();
          render();
          resetForm();
          setMessage(`已导入 ${tasks.length} 条安排到当前周。`, "success");
        });
        weekPrevButton?.addEventListener("click", () => switchWeek(shiftWeek(selectedWeekStart, -1)));
        weekTodayButton?.addEventListener("click", () => switchWeek(new Date()));
        weekNextButton?.addEventListener("click", () => switchWeek(shiftWeek(selectedWeekStart, 1)));
        typeButtons.forEach((button) => {
          button.addEventListener("click", () => {
            form.elements.type.value = button.dataset.plannerType || "custom";
            form.elements.title.focus();
          });
        });

        resetForm();
        render();
      })();
    </script>
  </section>
</BaseLayout>
